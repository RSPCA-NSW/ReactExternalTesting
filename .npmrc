# --- Supply-chain hardening (commit this file to the UI bundle root) ---

# Never run dependency lifecycle scripts on install (pre/post-install hooks).
# Neutralises install-time payloads - the delivery vehicle for most 2025-26 incidents.
ignore-scripts=true

# Dependency cooldown: refuse versions published less than 7 days ago, so
# short-lived malicious releases are detected/yanked before we can install them.
# Requires npm >= 11.10.0. Value is in DAYS.
min-release-age=7

